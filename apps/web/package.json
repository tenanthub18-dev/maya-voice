{
  "name": "@voice-receptionist/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack && node scripts/check-client-secrets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:client-secrets": "node scripts/check-client-secrets.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:contract": "vitest run tests/integrations/contract.test.ts",
    "smoke:live": "node --import tsx scripts/smoke-live.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-intl": "4.13.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@electric-sql/pglite": "0.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "25.0.1",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
