# Worker-only, optional. Latency log path (fly.toml sets it) and the TeXML signature switch
# (keep "true" until a captured live Telnyx request shows whether TeXML fetches are signed).
LATENCY_JSONL_PATH=
TELNYX_TEXML_REQUIRE_SIGNATURE=true
# Optional: required (32+ random characters) only when signature mode is false.
# Configure the TeXML voice URL as /telnyx/texml?token=<this secret>.
# Never print that URL or enable access logs containing its query string.
TELNYX_TEXML_WEBHOOK_SECRET=
