{
  "_source": "https://docs.stripe.com/billing/subscriptions/usage-based/implementation-guide",
  "_status": "VERIFIED (docs example; values are the docs' Hypernian example, not our pricing)",
  "method": "POST",
  "url": "https://api.stripe.com/v1/prices",
  "auth": "HTTP Basic: secret key as username, empty password (curl -u \"$STRIPE_SECRET_KEY:\")",
  "content_type": "application/x-www-form-urlencoded",
  "form": {
    "currency": "usd",
    "unit_amount": "4",
    "billing_scheme": "per_unit",
    "transform_quantity[divide_by]": "100",
    "transform_quantity[round]": "up",
    "recurring[usage_type]": "metered",
    "recurring[interval]": "month",
    "recurring[meter]": "{{METER_ID}}",
    "product_data[name]": "Hypernian tokens"
  }
}
